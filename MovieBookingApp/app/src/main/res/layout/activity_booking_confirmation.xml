<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Success banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="32dp"
            android:paddingBottom="24dp">

            <ImageView
                android:id="@+id/iv_confirm_icon"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_check_circle"
                android:tint="@color/status_confirmed"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Booking Confirmed!"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your seats have been reserved. Enjoy the show! 🍿"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- ── Booking details card ─────────────────────────────────── -->
        <androidx.cardview.widget.CardView
            style="@style/Widget.App.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Booking ID row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Booking ID"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"/>

                    <TextView
                        android:id="@+id/tv_conf_booking_id"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/accent"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/divider" android:layout_marginBottom="12dp"/>

                <!-- Movie name -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">
                    <ImageView android:layout_width="16dp" android:layout_height="16dp"
                        android:src="@drawable/ic_movie" android:tint="@color/primary"
                        android:layout_marginEnd="8dp"/>
                    <TextView android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="Movie"
                        android:textColor="@color/text_secondary" android:textSize="13sp"/>
                    <TextView android:id="@+id/tv_conf_movie_name"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/white" android:textSize="13sp"
                        android:textStyle="bold" android:maxLines="2" android:gravity="end"/>
                </LinearLayout>

                <!-- Theater -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">
                    <ImageView android:layout_width="16dp" android:layout_height="16dp"
                        android:src="@drawable/ic_location" android:tint="@color/primary"
                        android:layout_marginEnd="8dp"/>
                    <TextView android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="Theater"
                        android:textColor="@color/text_secondary" android:textSize="13sp"/>
                    <TextView android:id="@+id/tv_conf_theater"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/white" android:textSize="13sp"
                        android:maxLines="2" android:gravity="end"/>
                </LinearLayout>

                <!-- Date/Time -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">
                    <ImageView android:layout_width="16dp" android:layout_height="16dp"
                        android:src="@drawable/ic_clock" android:tint="@color/primary"
                        android:layout_marginEnd="8dp"/>
                    <TextView android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="Date &amp; Time"
                        android:textColor="@color/text_secondary" android:textSize="13sp"/>
                    <TextView android:id="@+id/tv_conf_datetime"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/white" android:textSize="13sp"
                        android:gravity="end"/>
                </LinearLayout>

                <!-- Seats -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">
                    <ImageView android:layout_width="16dp" android:layout_height="16dp"
                        android:src="@drawable/ic_seat" android:tint="@color/primary"
                        android:layout_marginEnd="8dp"/>
                    <TextView android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="Seats"
                        android:textColor="@color/text_secondary" android:textSize="13sp"/>
                    <TextView android:id="@+id/tv_conf_seats"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/white" android:textSize="13sp"
                        android:fontFamily="monospace" android:gravity="end"/>
                </LinearLayout>

                <!-- Amount -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">
                    <ImageView android:layout_width="16dp" android:layout_height="16dp"
                        android:src="@drawable/ic_rupee" android:tint="@color/primary"
                        android:layout_marginEnd="8dp"/>
                    <TextView android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="Total Paid"
                        android:textColor="@color/text_secondary" android:textSize="13sp"/>
                    <TextView android:id="@+id/tv_conf_amount"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/accent" android:textSize="15sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <!-- Payment Method -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">
                    <ImageView android:layout_width="16dp" android:layout_height="16dp"
                        android:src="@drawable/ic_payment" android:tint="@color/primary"
                        android:layout_marginEnd="8dp"/>
                    <TextView android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="Payment"
                        android:textColor="@color/text_secondary" android:textSize="13sp"/>
                    <TextView android:id="@+id/tv_conf_payment_method"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/white" android:textSize="13sp"/>
                </LinearLayout>

                <!-- Status badge -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="Status"
                        android:textColor="@color/text_secondary" android:textSize="13sp"/>
                    <TextView android:id="@+id/tv_conf_status"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/white" android:textSize="12sp"
                        android:textStyle="bold" android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── QR Code Card ─────────────────────────────────────────── -->
        <androidx.cardview.widget.CardView
            style="@style/Widget.App.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Show this QR at the entrance"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginBottom="16dp"/>

                <ImageView
                    android:id="@+id/iv_qr_code"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:background="@color/white"
                    android:padding="8dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── Action Buttons ──────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btn_share_ticket"
                style="@style/Widget.App.Button.Outlined"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:text="Share Ticket"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btn_download_qr"
                style="@style/Widget.App.Button.Outlined"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:text="Download QR"/>
        </LinearLayout>

        <Button
            android:id="@+id/btn_view_bookings"
            style="@style/Widget.App.Button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="View My Bookings"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btn_go_home"
            style="@style/Widget.App.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Back to Home"
            android:layout_marginBottom="24dp"/>

    </LinearLayout>
</ScrollView>
