<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="@dimen/seat_margin">

    <FrameLayout
        android:id="@+id/view_seat"
        android:layout_width="@dimen/seat_size"
        android:layout_height="@dimen/seat_size"
        android:background="@drawable/bg_seat_available">

        <TextView
            android:id="@+id/tv_seat_label"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textSize="8sp"
            android:textColor="@color/white"/>
    </FrameLayout>
</FrameLayout>
